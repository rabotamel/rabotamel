# Строка подключения из Neon (Connection string). Подойдёт как есть, с ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Пароль для входа в админ-панель (обязателен). Имя вводить не нужно.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Необязательно: чат, куда бот пришлёт приветствие при старте (ваш Telegram ID).
# Предварительно нажмите /start у бота.
# ADMIN_CHAT_ID=123456789

# Необязательно
# GREETING_TEXT=Привет, это тестовый код.
# NETWORK_FAIL_THRESHOLD=8
# FLOOD_ROTATE_THRESHOLD=300
# MAX_POLLING_CRASHES=3

# Контакт для Web Push (требование протокола), по желанию замените на свою почту
# VAPID_SUBJECT=mailto:you@example.com
# Необязательно: отдельный секрет для подписи cookie входа
# SESSION_SECRET=

# «Купить конфеты» (необязательно; без токена соответствующий способ оплаты не работает)
# CRYPTO_PAY_TOKEN=          # токен Crypto Pay (@CryptoBot -> Crypto Pay -> My Apps); допустимо и имя CRYPTO_BOT_TOKEN
# STARS_BOT_TOKEN=           # отдельный бот, через который выставляются счета в Telegram Stars
# Оплата картой: чеки приходят в личные сообщения МОДЕРАТОРОВ (вкладка «Модераторы» на сайте) В БОТЕ ДЛЯ ЧЕКОВ, там же «Выдать / Отказать».
# CHECK_BOT_TOKEN=          # токен этого бота (отдельный от ботов-магазинов; не кладите его в ротацию)
# TOPUP_CARD_NUMBER=5599002131738728
# CRYPTO_PAY_FIAT=USD
# CRYPTO_PAY_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,LTC,TRX,USDC
# TOPUP_INVOICE_EXPIRES=3600
# TOPUP_POLL_INTERVAL=10
